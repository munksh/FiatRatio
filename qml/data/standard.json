 "terms": {
  "amortisation": {
   "en": "Amortisation: paying down the loan itself, not the interest.",
   "sv": "Amortering: att betala av själva lånet, inte räntan.",
   "de": "Tilgung: die Rückzahlung des Kredits selbst, nicht der Zinsen.",
   "ru": "Погашение основного долга: выплата самого кредита, а не процентов."
  },
  "interest": {
   "en": "Interest: what borrowing costs. It does not make the loan smaller.",
   "sv": "Ränta: vad det kostar att låna. Lånet blir inte mindre av den.",
   "de": "Zinsen: was das Leihen kostet. Der Kredit wird dadurch nicht kleiner.",
   "ru": "Проценты: цена кредита. Долг от них не уменьшается."
  },
  "net_worth": {
   "en": "Net worth: everything you own minus everything you owe, your part only.",
   "sv": "Nettoförmögenhet: allt du äger minus allt du är skyldig, bara din del.",
   "de": "Nettovermögen: alles, was du besitzt, minus alles, was du schuldest – nur dein Anteil.",
   "ru": "Чистый капитал: всё, чем вы владеете, минус все долги, только ваша доля."
  },
  "transfer": {
   "en": "Transfer: money moved between your own places. Not spending, not income.",
   "sv": "Överföring: pengar flyttade mellan dina egna ställen. Varken utgift eller inkomst.",
   "de": "Umbuchung: Geld zwischen deinen eigenen Konten. Weder Ausgabe noch Einnahme.",
   "ru": "Перевод: деньги между вашими же счетами. Не расход и не доход."
  },
  "my_share": {
   "en": "Your part: what is yours of something shared. The whole is shown beside it.",
   "sv": "Din del: det som är ditt av något ni delar. Helheten visas bredvid.",
   "de": "Dein Anteil: was dir von etwas Geteiltem gehört. Das Ganze steht daneben.",
   "ru": "Ваша доля: ваша часть общего. Полная сумма показана рядом."
  },
  "planned": {
   "en": "Planned: expected but not paid yet. It already counts against what is left.",
   "sv": "Planerad: väntad men inte betald. Den räknas redan bort från det som är kvar.",
   "de": "Geplant: erwartet, aber noch nicht bezahlt. Zählt schon gegen den Rest.",
   "ru": "Запланировано: ожидается, но ещё не оплачено. Уже вычтено из остатка."
  }
 }
}